    "sns.heatmap(corr[['TARGET']].sort_values(by='TARGET', ascending=False), annot=True, cmap='coolwarm', center=0)\n",
    "plt.title('Correlation between *_0 variables and TARGET')\n",
    "plt.show()\n"
