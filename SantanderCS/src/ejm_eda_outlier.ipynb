   "source": [
    "# 3. IQR 기반 이상치 기준 계산\n",
    "Q1 = desc.loc[\"25%\"]\n",
    "Q3 = desc.loc[\"75%\"]\n",
    "IQR = Q3 - Q1\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n"
   ]
  },
