   "source": [
    "\n",
    "# describe 결과 불러오기\n",
    "desc = pd.read_csv(\"../data/describe_summary.csv\", index_col=0)\n",
    "\n",
    "# 2. 원본 데이터 불러오기\n",
    "df = pd.read_csv(\"../data/train.csv\")"
   ]
