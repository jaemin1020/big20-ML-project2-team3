      "File \u001b[1;32mc:\\ProgramData\\anaconda3\\envs\\pycaret_env\\lib\\site-packages\\matplotlib\\axes\\_axes.py:4442\u001b[0m, in \u001b[0;36mAxes._parse_scatter_color_args\u001b[1;34m(c, edgecolors, kwargs, xsize, get_next_color_func)\u001b[0m\n\u001b[0;32m   4439\u001b[0m             \u001b[38;5;28;01mraise\u001b[39;00m invalid_shape_exception(c\u001b[38;5;241m.\u001b[39msize, xsize) \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01merr\u001b[39;00m\n\u001b[0;32m   4440\u001b[0m         \u001b[38;5;66;03m# Both the mapping *and* the RGBA conversion failed: pretty\u001b[39;00m\n\u001b[0;32m   4441\u001b[0m         \u001b[38;5;66;03m# severe failure => one may appreciate a verbose feedback.\u001b[39;00m\n\u001b[1;32m-> 4442\u001b[0m         \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\n\u001b[0;32m   4443\u001b[0m             \u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mc\u001b[39m\u001b[38;5;124m'\u001b[39m\u001b[38;5;124m argument must be a color, a sequence of colors, \u001b[39m\u001b[38;5;124m\"\u001b[39m\n\u001b[0;32m   4444\u001b[0m             \u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mor a sequence of numbers, not \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mc\u001b[38;5;132;01m!r}\u001b[39;00m\u001b[38;5;124m\"\u001b[39m) \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01merr\u001b[39;00m\n\u001b[0;32m   4445\u001b[0m \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[0;32m   4446\u001b[0m     \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28mlen\u001b[39m(colors) \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;129;01min\u001b[39;00m (\u001b[38;5;241m0\u001b[39m, \u001b[38;5;241m1\u001b[39m, xsize):\n\u001b[0;32m   4447\u001b[0m         \u001b[38;5;66;03m# NB: remember that a single color is also acceptable.\u001b[39;00m\n\u001b[0;32m   4448\u001b[0m         \u001b[38;5;66;03m# Besides *colors* will be an empty array if c == 'none'.\u001b[39;00m\n",
      "\u001b[1;31mValueError\u001b[0m: 'c' argument must be a color, a sequence of colors, or a sequence of numbers, not array(['Cluster 2', 'Cluster 12', 'Cluster 0', 'Cluster 0', 'Cluster 0',\n       'Cluster 10', 'Cluster 1', 'Cluster 1', 'Cluster 2', 'Cluster 3',\n       'Cluster 4', 'Cluster 5', 'Cluster 4', 'Cluster 6', 'Cluster 6',\n       'Cluster 14', 'Cluster 7', 'Cluster 8', 'Cluster 8', 'Cluster 13',\n       'Cluster 9', 'Cluster 9', 'Cluster 7', 'Cluster 10', 'Cluster 14',\n       'Cluster 11', 'Cluster 11', 'Cluster 10', 'Cluster 9',\n       'Cluster 15', 'Cluster 12', 'Cluster 12', 'Cluster 12',\n       'Cluster 2', 'Cluster 13', 'Cluster 13', 'Cluster 13', 'Cluster 1',\n       'Cluster 14', 'Cluster 14', 'Cluster 14', 'Cluster 13',\n       'Cluster 15', 'Cluster 3', 'Cluster 5', 'Cluster 16', 'Cluster 16',\n       'Cluster 7', 'Cluster 3', 'Cluster 15', 'Cluster 2'], dtype=object)"
     ]
